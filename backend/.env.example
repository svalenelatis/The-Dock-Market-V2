# Supabase
# Project URL - found in: Dashboard > Project Settings > API > Project URL
SUPABASE_URL=https://your-project.supabase.co

# Anon (public) key - used to create per-request clients for JWT verification
# Found in: Dashboard > Project Settings > API > Project API keys > anon/public
SUPABASE_ANON_KEY=your-anon-key-here

# Service role key - used for privileged operations that bypass RLS
# Found in: Dashboard > Project Settings > API > Project API keys > service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Server configuration
PORT=3001
FRONTEND_URL=http://localhost:5173
